include(ExternalProject)
set(BC_JPEG_PREFIX "${CMAKE_CURRENT_BINARY_DIR}/jpeg")
file(MAKE_DIRECTORY "${BC_JPEG_PREFIX}/include")
set(BC_JPEG_NAME jpeg)
if(MSVC OR CMAKE_C_SIMULATE_ID STREQUAL "MSVC")
  set(BC_JPEG_NAME jpeg-static)
endif()
set(BC_JPEG_LIBRARY "${BC_JPEG_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}${BC_JPEG_NAME}${CMAKE_STATIC_LIBRARY_SUFFIX}")
set(BC_JPEG_ARGS
  -DCMAKE_INSTALL_PREFIX:PATH=${BC_JPEG_PREFIX} -DCMAKE_INSTALL_LIBDIR:PATH=lib
  -DENABLE_SHARED:BOOL=OFF -DENABLE_STATIC:BOOL=ON -DWITH_TURBOJPEG:BOOL=OFF
  -DWITH_TOOLS:BOOL=OFF -DWITH_TESTS:BOOL=OFF -DWITH_JAVA:BOOL=OFF
  -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON -DCMAKE_C_VISIBILITY_PRESET:STRING=hidden)
foreach(var CMAKE_TOOLCHAIN_FILE CMAKE_C_COMPILER CMAKE_C_COMPILER_TARGET CMAKE_OSX_SYSROOT CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_BUILD_TYPE CMAKE_MSVC_RUNTIME_LIBRARY VCPKG_TARGET_TRIPLET VCPKG_HOST_TRIPLET VCPKG_CHAINLOAD_TOOLCHAIN_FILE)
  if(DEFINED ${var} AND NOT "${${var}}" STREQUAL "")
    list(APPEND BC_JPEG_ARGS "-D${var}=${${var}}")
  endif()
endforeach()
if(MSVC)
  string(TOLOWER "${CMAKE_C_COMPILER_ARCHITECTURE_ID}" BC_JPEG_ARCH)
  if(BC_JPEG_ARCH STREQUAL "x64")
    set(BC_JPEG_ARCH AMD64)
  elseif(BC_JPEG_ARCH STREQUAL "x86")
    set(BC_JPEG_ARCH x86)
  endif()
  if(BC_JPEG_ARCH)
    list(APPEND BC_JPEG_ARGS "-DCMAKE_SYSTEM_NAME=Windows" "-DCMAKE_SYSTEM_PROCESSOR=${BC_JPEG_ARCH}")
  endif()
endif()
if(CMAKE_OSX_ARCHITECTURES)
  string(REPLACE ";" "|" BC_JPEG_ARCHS "${CMAKE_OSX_ARCHITECTURES}")
  list(APPEND BC_JPEG_ARGS "-DCMAKE_OSX_ARCHITECTURES=${BC_JPEG_ARCHS}")
endif()
ExternalProject_Add(bcontrol-jpeg-build
  SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/libjpeg-turbo"
  BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/jpeg-build"
  DOWNLOAD_COMMAND "" UPDATE_COMMAND "" LIST_SEPARATOR "|"
  CMAKE_ARGS ${BC_JPEG_ARGS}
  BUILD_BYPRODUCTS "${BC_JPEG_LIBRARY}")
add_library(bcontrol_jpeg STATIC IMPORTED GLOBAL)
set_target_properties(bcontrol_jpeg PROPERTIES IMPORTED_LOCATION "${BC_JPEG_LIBRARY}"
  INTERFACE_INCLUDE_DIRECTORIES "${BC_JPEG_PREFIX}/include")
add_dependencies(bcontrol_jpeg bcontrol-jpeg-build)
install(FILES third_party/libjpeg-turbo/LICENSE.md third_party/libjpeg-turbo/README.ijg
  DESTINATION share/licenses/bcontrol/libjpeg-turbo)
