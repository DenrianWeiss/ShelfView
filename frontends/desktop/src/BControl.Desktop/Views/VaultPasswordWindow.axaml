<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:BControl.Desktop.Markup" x:Class="BControl.Desktop.Views.VaultPasswordWindow"
        Title="{loc:Tr vault.changePassword}" Width="420" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="{loc:Tr vault.masterPassword}" />
    <TextBox Name="Password" PasswordChar="•" />
    <TextBlock Text="{loc:Tr vault.confirmPassword}" />
    <TextBox Name="Confirmation" PasswordChar="•" />
    <TextBlock Name="Status" TextWrapping="Wrap" />
    <ProgressBar Name="Progress" IsIndeterminate="True" Height="4" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{loc:Tr common.cancel}" Click="OnCancel" IsCancel="True" />
      <Button Name="Save" Content="{loc:Tr common.confirm}" Click="OnSave" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
