<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:BControl.Desktop.Markup" x:Class="BControl.Desktop.Views.CredentialWindow"
        Title="{loc:Tr server.password}" Width="420" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Name="Notice" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Tr add.username}" />
    <TextBox Name="Username" />
    <TextBlock Text="{loc:Tr server.password}" />
    <TextBox Name="Password" PasswordChar="•" />
    <CheckBox Name="SaveCredential" Content="{loc:Tr server.saveToVault}" IsChecked="True" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{loc:Tr common.cancel}" Click="OnCancel" />
      <Button Content="{loc:Tr common.connect}" Click="OnConnect" />
    </StackPanel>
  </StackPanel>
</Window>
