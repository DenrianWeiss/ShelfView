<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:BControl.Desktop.Markup"
        x:Class="BControl.Desktop.Views.MediaCloseDialog"
        Title="{loc:Tr media.closeTitle}"
        Width="420" Height="180"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Name="Message" TextWrapping="Wrap"
               Text="{loc:Tr media.closeMessage}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{loc:Tr media.keepAndClose}" Click="OnKeep" />
      <Button Content="{loc:Tr media.ejectAndClose}" Click="OnEject" />
      <Button Content="{loc:Tr common.cancel}" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
