<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:BControl.Desktop.Markup"
        xmlns:views="using:BControl.Desktop.Views"
        x:Class="BControl.Desktop.Views.ServerControlWindow"
        x:CompileBindings="False"
        Title="{Binding Title}"
        Width="720" Height="560" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#B00020" />
    </StackPanel>

    <TabControl x:Name="Sections" Grid.Row="1" Margin="0,12" SelectionChanged="OnSectionChanged">
      <TabItem Header="{loc:Tr manage.ipmi.tab.power}">
    <ScrollViewer Margin="12">
      <StackPanel Spacing="16">
        <views:PowerControlView />

        <StackPanel Spacing="6">
          <TextBlock Text="{Binding BootHeading}" FontWeight="Bold" />
          <TextBlock Text="{Binding BootStatus}" TextWrapping="Wrap" Foreground="Gray" />
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding TargetLabel}" />
              <ComboBox ItemsSource="{Binding BootTargets}" SelectedItem="{Binding SelectedTarget}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="{Binding ModeLabel}" />
              <ComboBox ItemsSource="{Binding BootModes}" SelectedItem="{Binding SelectedMode}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <Button Content="{loc:Tr common.set}" Click="OnBoot" IsEnabled="{Binding CanApplyBoot}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Tr manage.ipmi.tab.sensors}" Tag="{Binding Sensors}">
        <views:ManagementDataView DataContext="{Binding Sensors}" />
      </TabItem>
      <TabItem Header="{loc:Tr manage.ipmi.tab.sel}" Tag="{Binding Sel}" IsVisible="{Binding IsIpmi}">
        <views:ManagementDataView DataContext="{Binding Sel}" />
      </TabItem>
      <TabItem Header="{loc:Tr manage.ipmi.tab.fru}" Tag="{Binding Inventory}">
        <views:ManagementDataView DataContext="{Binding Inventory}" />
      </TabItem>
      <TabItem x:Name="NetworkTab" Header="{loc:Tr manage.ipmi.tab.network}" Tag="{Binding Network}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel IsVisible="{Binding ShowConsoleMode}" Spacing="6" Margin="12">
            <TextBlock Text="{loc:Tr manage.consoleMode.title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConsoleModeCurrent}" />
            <TextBlock Text="{Binding ConsoleModeStatus}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !ConsoleModeBusy}">
              <Button Content="{Binding ConsoleModeSwitchLabel}" Click="OnSwitchConsoleMode" IsVisible="{Binding CanSwitchConsoleMode}" />
              <Button Content="{loc:Tr common.refresh}" Click="OnRefreshConsoleMode" />
            </StackPanel>
          </StackPanel>
          <views:ManagementDataView Grid.Row="1" DataContext="{Binding Network}" />
        </Grid>
      </TabItem>
    </TabControl>

    <Button Grid.Row="2" Content="{loc:Tr common.close}" Click="OnClose" HorizontalAlignment="Right" />
  </Grid>
</Window>
